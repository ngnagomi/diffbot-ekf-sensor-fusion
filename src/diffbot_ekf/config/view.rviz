Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:

    # Floor grid, 1 m squares
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Value: true

    # The robot's 3D model, read from robot_state_publisher
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true

    # Coordinate frames as small axes
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true

    # RED: where wheel odometry thinks the robot is
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry (red)
      Enabled: true
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 40; 40
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.04
      Topic:
        Value: /wheel/odometry
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true

    # GREEN: where the robot really is (ground truth)
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (green)
      Enabled: true
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 40; 220; 40
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.04
      Topic:
        Value: /ground_truth/odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true

    # BLUE: the EKF's fused estimate
    - Class: rviz_default_plugins/Odometry
      Name: EKF fused (blue)
      Enabled: true
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 40; 120; 255
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.04
      Topic:
        Value: /odometry/filtered
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.8
      Value: Orbit (rviz)

Window Geometry:
  Width: 1200
  Height: 800
<?xml version="1.0"?>
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions (meters) and masses (kg) -->
  <xacro:property name="PI"        value="3.14159265"/>
  <xacro:property name="chassis_l" value="0.40"/>
  <xacro:property name="chassis_w" value="0.30"/>
  <xacro:property name="chassis_h" value="0.10"/>
  <xacro:property name="chassis_m" value="5.0"/>
  <xacro:property name="wheel_r"   value="0.05"/>
  <xacro:property name="wheel_len" value="0.04"/>
  <xacro:property name="wheel_m"   value="0.5"/>
  <xacro:property name="wheel_sep" value="0.35"/>
  <xacro:property name="caster_r"  value="0.05"/>
  <xacro:property name="caster_m"  value="0.2"/>

  <!-- Inertia helpers: standard formulas -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- =Chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_m}" x="${chassis_l}" y="${chassis_w}" z="${chassis_h}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Wheels-->
  <xacro:macro name="wheel" params="side y">

    <link name="${side}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_len}"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_len}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_m}" r="${wheel_r}" h="${wheel_len}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} ${-chassis_h/2}" rpy="${-PI/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1><mu2>1.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

  </xacro:macro>

  <!-- Make two wheels-->

  <xacro:wheel side="left"  y="${ wheel_sep/2}"/>
  <xacro:wheel side="right" y="${-wheel_sep/2}"/>

  <!-- Caster -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="${caster_r}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_r}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_m}" r="${caster_r}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${chassis_l/2 - caster_r} 0 ${-chassis_h/2}"/>
  </joint>

  <gazebo reference="caster">
    <mu1>0.0</mu1> <!-- no friction (slides along instead of dragging)-->
    <mu2>0.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Diff-drive controller: motors + wheel encoders -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>odom:=wheel/odometry</remapping> <!-- rename topic to wheel/odometry-->
      </ros>
      <update_rate>50</update_rate> <!-- publish 50 times per sec -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_diameter>${2*wheel_r}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <odometry_source>0</odometry_source> <!-- default is 1, need to set to 0 -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Publishes real wheel angles so the wheels show correctly in RViz  -->
  <gazebo>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

    <!-- IMU: mounted on top of the chassis, centered -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- Noise helper: one Gaussian noise block -->
  <xacro:macro name="noise" params="std bias_mean bias_std">
    <noise type="gaussian">
      <mean>0.0</mean>
      <stddev>${std}</stddev>
      <bias_mean>${bias_mean}</bias_mean>
      <bias_stddev>${bias_std}</bias_stddev>
    </noise>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
      <imu>
        <angular_velocity>
          <x><xacro:noise std="2e-4" bias_mean="7.5e-6" bias_std="8e-7"/></x>
          <y><xacro:noise std="2e-4" bias_mean="7.5e-6" bias_std="8e-7"/></y>
          <z><xacro:noise std="2e-4" bias_mean="7.5e-6" bias_std="8e-7"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:noise std="1.7e-2" bias_mean="0.1" bias_std="0.001"/></x>
          <y><xacro:noise std="1.7e-2" bias_mean="0.1" bias_std="0.001"/></y>
          <z><xacro:noise std="1.7e-2" bias_mean="0.1" bias_std="0.001"/></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Robot's true pose from Gazebo (only for evaluation) -->
  <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>